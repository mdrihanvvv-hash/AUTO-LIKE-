            f"────────────────────\n"
            f"🎯 <b>Player:</b> <code>{api_response.get('PlayerNickname', 'N/A')}</code>\n"
            f"🆔 <b>UID:</b> <code>{api_response.get('UID', 'N/A')}</code>\n"
