def reset_daily_data():
    for file in [VERIFIED_FILE, SHORT_LINK_FILE, USAGE_FILE, TOKEN_FILE]:
        if os.path.exists(file):
            with open(file, 'w') as f:
                json.dump([], f)
    print(f"[{datetime.now(BD_TZ)}] ✅ Daily data reset completed!")

